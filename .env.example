# Replace all placeholders. The example values are for local development only.
POSTGRES_USER="hexvault"
POSTGRES_PASSWORD="replace_with_local_dev_password"
POSTGRES_DB="hexvault"
POSTGRES_PORT="55436"
POSTGRES_BIND_ADDRESS="127.0.0.1"
DATABASE_URL="postgresql://hexvault:replace_with_local_dev_password@localhost:55436/hexvault?schema=public"
# Prisma CLI/migrations: direct (or session-pooler) connection. For local Docker this matches DATABASE_URL.
DIRECT_URL="postgresql://hexvault:replace_with_local_dev_password@localhost:55436/hexvault?schema=public"
DATABASE_URL_DOCKER="postgresql://hexvault:replace_with_local_dev_password@postgres:5432/hexvault?schema=public"
AUTH_SECRET="generate-a-random-secret-with-at-least-32-bytes"
NOTES_ENCRYPTION_KEY="generate-a-separate-random-secret-with-at-least-32-bytes"
APP_URL="http://localhost:3000"
API_INTERNAL_URL="http://localhost:4000"
# For a standalone web deployment on Vercel, set API_INTERNAL_URL there to the
# deployed API origin (HTTPS), so missing web API routes are forwarded to it.
API_BIND_ADDRESS="127.0.0.1"
API_PORT="4000"
COMPANY_TIMEZONE="Asia/Kolkata"
# Set on the API service and in the external scheduler. Call the backups cron
# endpoint every minute with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""
# Private uploads require S3_BUCKET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY.
# Production: configure these server-side on BOTH web and API deployments.
# API_INTERNAL_URL only forwards missing routes; web has local upload handlers.
# Use an existing private bucket and its real region. For AWS S3 leave endpoint
# overrides empty; for compatible providers use their HTTPS S3 endpoint.
# S3_PUBLIC_ENDPOINT must be reachable by the browser, not a Docker hostname.
# Bucket CORS must allow PUT for R2 (POST for other providers) from APP_URL.
# Use docs/r2-cors.json for the production R2 bucket's dashboard CORS policy.
# The localhost values below are only for the local Docker storage service.
S3_ENDPOINT="http://localhost:9000"
S3_ENDPOINT_DOCKER="http://rustfs:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_BIND_ADDRESS="127.0.0.1"
S3_PORT="9000"
S3_CONSOLE_BIND_ADDRESS="127.0.0.1"
S3_CONSOLE_PORT="9001"
S3_REGION="us-east-1"
S3_BUCKET="hexvault-private"
S3_ACCESS_KEY_ID="hexvault-local"
S3_SECRET_ACCESS_KEY="hexvault-local-only-change-me"
# Resend is preferred when configured; set RESEND_FROM to a verified sender for production.
RESEND_API_KEY=""
RESEND_FROM="HEXVAULT <onboarding@resend.dev>"
# Brevo is supported as a secondary HTTPS API option.
BREVO_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="HEXVAULT <no-reply@example.com>"
# Separate Gmail sender for approved HR letters (Google app password, not the account password).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
