{
    "name": "hexvault-workforce-os",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "apps/web",
        "apps/api",
        "packages/core"
    ],
    "scripts": {
        "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
        "dev:web": "npm run dev --workspace @hexvault/web",
        "dev:api": "npm run dev --workspace @hexvault/api",
        "build": "npm run build:web && npm run build:api",
        "build:web": "npm run build --workspace @hexvault/web",
        "build:api": "npm run build --workspace @hexvault/api",
        "start:web": "npm run start --workspace @hexvault/web",
        "start:api": "npm run start --workspace @hexvault/api",
        "lint": "eslint apps/web/src apps/api/src packages/core/src",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate deploy",
        "seed:owner": "node scripts/seed-owner.mjs"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1169.0",
        "@aws-sdk/s3-presigned-post": "^3.1169.0",
        "@aws-sdk/s3-request-presigner": "^3.1169.0",
        "@prisma/client": "6.19.3",
        "bcryptjs": "^3.0.3",
        "lucide-react": "^1.73.0",
        "next": "16.4.6",
        "nodemailer": "^10.6.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^20",
        "@types/nodemailer": "^8.0.2",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "concurrently": "^10.0.7",
        "eslint": "^9",
        "eslint-config-next": "16.4.6",
        "prisma": "6.19.3",
        "tailwindcss": "4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^5"
    }
}
