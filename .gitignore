**/node_modules/
/hexvault-temp/
/hexvault/
/archive/
.turbo/
.cache/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing and generated reports
**/coverage/
**/test-results/
**/playwright-report/
**/playwright/.cache/
**/storybook-static/

# next.js
**/.next/
**/out/
**/.vercel/

# production
**/build/
**/dist/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# local runtime data and temporary files
/storage/
/uploads/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# local secrets (keep the safe template committed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
